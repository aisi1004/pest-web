[{"t":"d","k":"D00004397","n":"점무늬병","e":"Leaf Spot","img":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b47d447dfeb676139127c8d4f11ef6b6a68febd4a7cfbfbf38f3ffe436348b8d426d049319a462d87d12fcb28d9440e618","sym":"레몬밤 점무늬병은 빈번하게 주로 잎에만 발생하며, 작물의 조기낙엽을 유발하여 수량을 감소시키고, 품질을 저하시키며, 식물의 관상가치를 떨어트린다.\n병반은 잎의 윗면에서 처음에 작고 뚜렷한 연갈색 또는 어두운 갈색 점무늬가 나타난 후 점점 발전하여 확대되며, 병반의 마진은 이병부와 확실하게 구별된다.\n병반부 형태는 구형∼부정형 또는 다각형이다.","dev":"","pre":"","chem":"","bio":"","route":"","im":[{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b47d447dfeb676139127c8d4f11ef6b6a6432ff2a1ef2416b2402b4f89c64436a9fe234dbb9b0b97e48b03b12ae0114e5d","t":"병징1(잎)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b45d4a8175c0646dc126c6bb66cfb2860207e9900cb6e4fa6e789fce89e8b03f99fe234dbb9b0b97e48b03b12ae0114e5d","t":"병징2(잎)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b46a22137c80bd75e16ce32a642a957430230bd06eb1523df06570bb4c2d585d46fe234dbb9b0b97e48b03b12ae0114e5d","t":"병징3(잎)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b43846d32bc489749d1ac6b56a1f545e610fb6b6b32aa7d5cf1784ebb832cadf48fe234dbb9b0b97e48b03b12ae0114e5d","t":"병징4(잎)"}]}]