[{"t":"d","k":"D00004305","n":"노균병","e":"Downy mildew","img":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=8be55fc89d8ee318e099f7390e5f4e4a490f51189e788356ee7b810cd9167aed72343e273c292dbfde78ddbec46f7b8b","sym":"잎에서는 발병 초기에 연한 노란색 점무늬가 형성되고，뒷면에는 흰색의 분생포자경과 연갈색의 분생포자가 대량으로 형성되어 회색 또는 갈색으로 보인다.\n병이 진전되면서 병반이 잎 전체로 퍼지고，조기낙엽을 가져온다.","dev":"6월에 발병하기 시작하며，7월 장마철에는 발병률이 매우 높다.\n병원균은 최소6시간 동안 100%의 상대습도가 유지되어야만 분생포자를 형성하며，발병적온은15~20℃이다.\n병원균은 병든 식물체의 조직 속에서 난포자 상태로 월동하여 이듬해 새로운 식물체가 파종되어 생장하면 다시 발아하여 지상부로 침입하고，잎 뒷면에서 다량의 포자를 형성하여 공기 중으로 쉽게 전반된다.","pre":"병든 식물체는 조기에 제거한다.\n\n노균병은 일단 발병하면 병 진전이 빨라 예방이 매우 중요하다.\n특히 유기농업자재는 식물체내 침투이행성이 없거나 적기 때문에 병이 발생된 후에 처리할 경우그 효과가 저조하다.\n노균병 방제에 활용이 가능한 유기농업자재 허용물질은 석회보르도액，석회황합제，유황제，동제，난황유，식물성 기름 등이다.\n그러나 퀴노아노균병을 대상으로 시험된 바는 없으므로 약효，약해에 주의하여 사용하여야 한다","chem":"","bio":"","route":"","im":[{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=d4eaafd0869ae8270db4caea11722a22b919a0720052efd62da623a686ef9a26e7f32acc00c62f85171badcbef892302","t":"퀴노아잎피해1(잎)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=d4eaafd0869ae8270db4caea11722a22ec727e998f6ca3d721fb81e8563a0070d71810d9be1b2fa6e2c74102abfab451","t":"퀴노아잎피해2(잎)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=8be55fc89d8ee318e099f7390e5f4e4a490f51189e788356ee7b810cd9167aeda00e34a33479f3eae7d59ab0d1929cd1","t":"노균병 병징_1(잎)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=8437be804faf1bf7bc609cb357a0369517333ce423057490c1f8eee5cfaad4cad40cfaf25078187c45dad0f82e9dd52e","t":"노균병 병징_2(잎)"}]},{"t":"d","k":"D00004323","n":"시들음병","e":"","img":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=82937c64fb5d1583a435e0dd086e6b3344f27860d5b188d92a9190144b9eab5ba1dd0b4ee062d1f8a8808b63966a552a6d049319a462d87d12fcb28d9440e618","sym":"","dev":"","pre":"","chem":"","bio":"","route":"","im":[{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=293c4cac4eaacdc270353ab28e6f909f1138b70bf060a9f8e82cc45d74e8625b6d049319a462d87d12fcb28d9440e618","t":"시들음병 확대_1(줄기)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=33a62d2d3ba64a23177397408dc0f0b20478d489c07c7599deb65bfc1819c18f36cc79799e3cc469838e47888080254b","t":"시들음병 확대_2(줄기)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=82937c64fb5d1583a435e0dd086e6b3307dda5b5488157e6d99e598f4867e7f53498b637998557a6bdd7ab1059ab2f90fe234dbb9b0b97e48b03b12ae0114e5d","t":"시들음병 병징_1(줄기)"},{"u":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=82937c64fb5d1583a435e0dd086e6b3367739f139fae25de872d7023e5b2e1a66cb06c5bfaf98f0bd9f5d14e0f9c1382fe234dbb9b0b97e48b03b12ae0114e5d","t":"시들음병 병징_2(줄기)"}]}]